DATABASE_URL=postgres://fluesterlos:fluesterlos@db:5432/fluesterlos
# One-time secret for first owner registration (Host UI). Change before first boot.
BOOTSTRAP_TOKEN=change-me-once
PORT=3000
# Used for join URLs and cookie Secure flag (https -> Secure cookies).
PUBLIC_URL=http://localhost:8080
VITE_API_URL=
# Browser origins allowed for credentialed CORS (comma-separated). Default: the origin of PUBLIC_URL.
# Example for local Vite dev against a separate API: http://localhost:5173
CORS_ORIGINS=
# Which proxy hops to trust for X-Forwarded-For (client IP for rate limits). Default trusts private networks (nginx in compose).
TRUST_PROXY=loopback,linklocal,uniquelocal
# Country used to read guest phone numbers typed without +country code (ISO 3166 alpha-2).
# "081 234 5678" becomes +66812345678 with TH. Numbers starting with + are kept as typed.
DEFAULT_PHONE_COUNTRY=TH
# Default time zone for new events (IANA name). Hosts can pick another per event; times are stored in UTC
# and always entered/shown in the event's zone, whatever zone the host's or guest's device is in.
DEFAULT_EVENT_TIMEZONE=Asia/Bangkok
# Optional rate-limit overrides (defaults shown).
# RATE_LIMIT_JOIN_PER_MIN=10        # per IP + phone
# RATE_LIMIT_VERIFY_PER_10MIN=10    # per IP + phone (plus max 5 tries per code)
# RATE_LIMIT_BID_PER_10S=20         # per guest
# RATE_LIMIT_LOGIN_PER_MIN=10       # host login, per IP + email
# Persistent uploads: voucher PDFs, payslips, host QR, item photos, sponsor logos (mounted in compose).
DATA_DIR=/data
# SMTP for voucher emails and guest login codes (codes go to the guest's email if they gave one).
# Without SMTP (or without a guest email) login codes show on the host Help desk card and in the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
